# ========================================================
# Omeetso Backend - Environment Configuration Template
# Copy this file to '.env' and fill in your real credentials.
# NEVER commit the real '.env' to version control!
# ========================================================

# Application & Networking
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_USER_URL=http://localhost:5173
CLIENT_ADMIN_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# MongoDB Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Token Signing Secrets (Generate strong 32+ character secrets)
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_here
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=90d

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_or_live_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Combirds SMS Gateway Credentials (DLT Compliant)
SMS_PROVIDER=combirds
COMBIRDS_API_KEY=your_combirds_api_key
COMBIRDS_GATEWAY_URL=https://api.combirds.com/api/v1/sms/send
COMBIRDS_SENDER_ID=OMEETS
COMBIRDS_DLT_TE_ID=your_dlt_template_id
COMBIRDS_SMS_TYPE=otp
COMBIRDS_MESSAGE_TEMPLATE="your OTP for login is {#num#} - OMEETSO"

# SMTP Transactional Email (Hostinger / Custom)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@omeetso.in
SMTP_PASS=your_smtp_mailbox_password
SMTP_FROM=info@omeetso.in
SMTP_FROM_NAME=Omeetso
ADMIN_NOTIFICATION_EMAIL=info@omeetso.in

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Admin Seeder (Optional)
INITIAL_ADMIN_EMAIL=admin@digitalness.co.in
INITIAL_ADMIN_PASSWORD=your_initial_admin_password
INITIAL_ADMIN_NAME="Super Admin"
