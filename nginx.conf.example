# Omeetso Production Nginx Configuration for Hostinger VPS / Ubuntu
# Save as /etc/nginx/sites-available/omeetso and symlink to /etc/nginx/sites-enabled/

# 1. 301 Permanent Redirect: WWW to non-WWW (HTTP and HTTPS)
server {
    listen 80;
    listen [::]:80;
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.omeetso.in www.yourdomain.com;

    # SSL Certificates (managed by Certbot)
    # ssl_certificate /etc/letsencrypt/live/omeetso.in/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/omeetso.in/privkey.pem;

    return 301 https://omeetso.in$request_uri;
}

# 2. 301 Permanent Redirect: HTTP to HTTPS (non-WWW)
server {
    listen 80;
    listen [::]:80;
    server_name omeetso.in yourdomain.com;
    return 301 https://omeetso.in$request_uri;
}

# 3. Main Production Server Block (HTTPS)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name omeetso.in yourdomain.com;

    # SSL Certificates (managed by Certbot)
    # ssl_certificate /etc/letsencrypt/live/omeetso.in/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/omeetso.in/privkey.pem;

    # Gzip Compression for Optimal Performance & Minified Delivery
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/x-javascript
        application/xml
        application/rss+xml
        image/svg+xml
        font/woff
        font/woff2;

    # Security Headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # 1. Dynamic OpenGraph Link Previews for Social Crawlers (WhatsApp, Facebook, Twitter, Telegram, Googlebot)
    location ~* ^/(product|p|store)/([a-zA-Z0-9_-]+)$ {
        if ($http_user_agent ~* "(facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Discordbot|Slackbot|Applebot|Pinterest|SkypeUriPreview|Googlebot)") {
            proxy_pass http://127.0.0.1:3000/api/v1/og/$1/$2;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            break;
        }
        root /var/www/omeetso/frontend/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Static Bundled Assets with 1-Year Immutable Browser Cache
    location /assets/ {
        root /var/www/omeetso/frontend/dist;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # robots.txt, sitemap.xml, ads.txt, icons direct delivery
    location ~* ^/(robots\.txt|sitemap\.xml|ads\.txt|iconpng\.png|manifest\.webmanifest)$ {
        root /var/www/omeetso/frontend/dist;
        expires 1d;
        add_header Cache-Control "public, must-revalidate";
        access_log off;
    }

    # Frontend Single Page Web App (User Portal)
    location / {
        root /var/www/omeetso/frontend/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # 2. Backend API Reverse Proxy
    location /api/ {
        proxy_pass http://127.0.0.1:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # 3. Socket.IO Real-time WebSocket Proxy
    location /socket.io/ {
        proxy_pass http://127.0.0.1:3000/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 4. Static Uploads / Media Cache
    location /uploads/ {
        alias /var/www/omeetso/backend/uploads/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }
}

# 4. Admin Subdomain (e.g. admin.omeetso.in)
server {
    listen 80;
    listen 443 ssl http2;
    server_name admin.omeetso.in admin.yourdomain.com;

    location / {
        root /var/www/omeetso/admin/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
