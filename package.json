{
  "name": "omeetso-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Omeetso local marketplace project - Monorepo root",
  "workspaces": [
    "frontend",
    "admin",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=admin",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build:contracts": "npm run build --workspace=@omeetso/contracts",
    "build:backend": "npm run build --workspace=backend",
    "migrate:images": "npm run migrate:images --workspace=backend",
    "build": "npm run build:contracts && npm run build --workspaces",
    "android:sync": "npm run cap:sync --workspace=frontend",
    "android:build": "npm run cap:build:apk --workspace=frontend",
    "android:open": "npm run cap:android --workspace=frontend",
    "cap:build:apk": "npm run cap:build:apk --workspace=frontend"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  }
}
